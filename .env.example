VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site address for link previews, sitemap and robots.txt (own domain, no trailing slash).
# Optional on Vercel: without it the production *.vercel.app domain is used.
SITE_URL=

# Umami analytics (cookieless). Leave empty to disable. See docs/GROWTH.md.
VITE_UMAMI_WEBSITE_ID=
# Comma-separated hostnames that may report (keeps preview deployments and localhost out).
VITE_UMAMI_DOMAINS=
# Self-hosted Umami only; defaults to https://cloud.umami.is/script.js
VITE_UMAMI_SCRIPT_URL=

# Server-only (Vercel functions), never with the VITE_ prefix. Email notifications, see docs/GROWTH.md.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATIONS_SECRET=
