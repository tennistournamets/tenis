{
  "rewrites": [
    {
      "source": "/tournaments/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|vkShare|Viber|SkypeUriPreview|Applebot|redditbot|Pinterestbot|Iframely|Embedly|Cardyb|Mastodon|kakaotalk-scrap).*"
        }
      ],
      "destination": "/api/preview?slug=:slug"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/ru",
      "destination": "/ru.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/ru/blog",
      "destination": "/ru/blog/index.html"
    },
    {
      "source": "/ru/blog/:slug",
      "destination": "/ru/blog/:slug.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog/index.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog/:slug.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/tournaments/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/tournaments/:slug/poster",
      "destination": "/app.html"
    },
    {
      "source": "/embed/:slug",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/_fonts/**"
    }
  }
}
